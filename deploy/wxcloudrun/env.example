# 在微信云托管的环境变量页面逐项设置；本文件不含真实凭证。
PORT=8080
SPRING_PROFILES_ACTIVE=production,wxcloudrun

# 项目使用 PostgreSQL 14+，不能填模板自带 MySQL。
# 同地域、资源互联中的内网地址优先；TLS 方式按数据库提供方要求设置。
DB_JDBC_URL=jdbc:postgresql://YOUR_PG_HOST:5432/campus?sslmode=require
DB_USER=campus
DB_PASSWORD=

# JWT 至少 48 位；管理员密码 16–64 位；数据库密码至少 20 位。
JWT_SECRET=
APP_ADMIN_PASSWORD=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 课表照片识别选配。Linux 云容器不能使用 Windows OCR。
COURSE_VISION_BASE_URL=
COURSE_VISION_API_KEY=
COURSE_VISION_MODEL=

# 可选校园数据接口；沿用已有应用凭证，在控制台填写。
XIAOBEI_BASE=https://xyadmin.tehii.top
XIAOBEI_CLIENT_ID=
XIAOBEI_CLIENT_SECRET=
