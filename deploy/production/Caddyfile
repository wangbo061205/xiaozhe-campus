{$CAMPUS_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    request_body {
        max_size 20MB
    }
    reverse_proxy backend:8080 {
        flush_interval -1
    }
}
