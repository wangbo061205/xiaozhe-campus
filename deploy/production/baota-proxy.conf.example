# Only for the xiaozhe.mxqi.cn site's server block, not the global nginx.conf.
# Replace an existing location / block rather than adding a duplicate block.
# The ^~ prefix prevents Baota's static-image/CSS cache locations from bypassing Java.
location ^~ / {
    proxy_pass http://127.0.0.1:18080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 20m;
    proxy_connect_timeout 10s;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;
    proxy_buffering off;
}
