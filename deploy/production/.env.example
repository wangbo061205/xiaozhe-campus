# 必填：只写主机名，不含 https://、端口和路径。
CAMPUS_DOMAIN=
ACME_EMAIL=

# init-env.sh 自动生成。不要手工复用测试环境密码。
DB_PASSWORD=
JWT_SECRET=
APP_ADMIN_PASSWORD=

# 必填：小折对话所用模型。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 可选：仅使用独立 Web 聊天和知识库时可留空。
XIAOBEI_BASE=https://xyadmin.tehii.top
XIAOBEI_CLIENT_ID=
XIAOBEI_CLIENT_SECRET=
