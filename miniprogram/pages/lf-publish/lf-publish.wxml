<view class="root {{gq}}">
  <glass-bg />
  <glass-nav title="发布信息" back />

  <view class="card">
    <view class="section-title">我要发布</view>

    <!-- 类型选择：两块玻璃 -->
    <view class="kind-row">
      <view class="kind-item glass-1 press {{kind === 'LOST' ? 'on' : ''}}"
            hover-class="pressed" hover-start-time="0" hover-stay-time="60"
            data-kind="LOST" bindtap="onKind">
        <text class="kind-icon">🔍</text>
        <text class="kind-text">我丢东西了</text>
      </view>
      <view class="kind-item glass-1 press {{kind === 'FOUND' ? 'on' : ''}}"
            hover-class="pressed" hover-start-time="0" hover-stay-time="60"
            data-kind="FOUND" bindtap="onKind">
        <text class="kind-icon">🎁</text>
        <text class="kind-text">我捡到东西</text>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">标题 <text class="req">*</text></view>
      <input class="form-input" placeholder="例如：丢失校园卡一张" placeholder-class="ph"
             value="{{title}}" bindinput="onTitle" maxlength="50" />
    </view>

    <view class="form-item">
      <view class="form-label">类别</view>
      <picker range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory">
        <view class="form-input picker-value">{{categories[categoryIndex]}}</view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">描述 <text class="req">*</text></view>
      <textarea class="form-textarea" placeholder="描述物品特征、丢失/拾获经过等（请勿填写完整证件号、手机号）"
                placeholder-class="ph" value="{{description}}" bindinput="onDesc" maxlength="500" />
    </view>

    <view class="form-item">
      <view class="form-label">地点</view>
      <input class="form-input" placeholder="例如：图书馆二楼 / 二食堂" placeholder-class="ph"
             value="{{location}}" bindinput="onLocation" maxlength="50" />
    </view>

    <view class="form-item">
      <view class="photo-heading"><view class="form-label">物品图片</view><text>{{images.length}} / 6</text></view>
      <view class="photo-grid">
        <view class="photo-tile" wx:for="{{images}}" wx:key="key">
          <image class="photo-preview" src="{{item.path}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage" />
          <view wx:if="{{!submitting}}" class="photo-remove" data-key="{{item.key}}" catchtap="removeImage" role="button" aria-label="移除第{{index + 1}}张图片"><image src="/assets/icons/x.png" /></view>
          <view wx:if="{{submitting}}" class="photo-upload-state">{{item.uploadId ? '已上传' : '等待上传'}}</view>
        </view>
        <view wx:if="{{images.length < 6}}" class="photo-tile photo-add" bindtap="chooseImages" role="button" aria-label="添加物品图片">
          <view class="photo-add-body"><image src="/assets/icons/image-green.png" /><text>{{choosingImages ? '选择中' : '添加图片'}}</text></view>
        </view>
      </view>
      <view class="photo-tip">支持拍照或从相册选择，最多 6 张 JPG / PNG，每张不超过 5MB。点击图片可预览。</view>
    </view>

    <view class="form-item">
      <view class="form-label">联系方式提示</view>
      <input class="form-input" placeholder="默认：站内留言联系" placeholder-class="ph"
             value="{{contactHint}}" bindinput="onContact" maxlength="50" />
    </view>

    <button class="btn-primary submit-btn" bindtap="submit" disabled="{{submitting || choosingImages}}">
      {{submitting ? uploadProgress : '提交发布'}}
    </button>
    <view class="form-tip">发布后需管理员审核，通过后展示在广场。敏感证件类物品请只描述特征，不要公开完整号码。</view>
  </view>
</view>
