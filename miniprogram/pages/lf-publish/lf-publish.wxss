/* 发布信息 —— 玻璃版 */

.kind-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.kind-item {
  flex: 1;
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: var(--content-radius);
  color: var(--ink-2);
  font-size: 27rpx;
  transition: box-shadow var(--dur-switch) var(--ease), color var(--dur-switch) var(--ease);
}

.kind-item.on {
  color: var(--campus-accent-ink);
  font-weight: 600;
  background: var(--campus-tone-blue);
  box-shadow: none;
}

.kind-icon {
  display: block;
  font-size: 46rpx;
  line-height: 1;
  margin-bottom: 12rpx;
}

.kind-text {
  line-height: 1.3;
}

.picker-value {
  color: var(--ink);
}

.ph {
  color: var(--ink-2);
}

.submit-btn {
  margin-top: 12rpx;
}

.root { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.kind-item.on { color: var(--campus-accent-ink); border-color: var(--campus-line); }
.photo-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.photo-heading>text { font-size: 24rpx; color: var(--ink-2); }
.photo-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18rpx; }
.photo-tile { position: relative; width: 100%; height: 0; padding-bottom: 100%; border: 1rpx solid var(--campus-line); border-radius: var(--content-radius); background: var(--campus-canvas); }
.photo-preview { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: var(--content-radius); }
.photo-remove { position: absolute; right: -6rpx; top: -6rpx; width: 56rpx; height: 56rpx; z-index: 2; display: flex; align-items: center; justify-content: center; background: var(--campus-surface); border: 1rpx solid var(--campus-line); border-radius: 50%; }
.photo-remove image { display: block; width: 30rpx; height: 30rpx; }
.photo-add { border-style: dashed; }
.photo-add-body { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 12rpx; color: var(--ink-2); font-size: 24rpx; }
.photo-add-body image { display: block; width: 40rpx; height: 40rpx; }
.photo-tip { font-size: 23rpx; line-height: 1.7; color: var(--ink-2); margin-top: 16rpx; }
.photo-upload-state { position: absolute; bottom: 0; left: 0; right: 0; padding: 4rpx; text-align: center; font-size: 21rpx; color: #fff; background: rgba(0,0,0,.55); }
