<view class="root schedule-root {{gq}}">
  <glass-bg /><glass-nav title="我的课表" back />
  <view class="schedule-heading">
    <view class="date-block"><view class="schedule-date">{{dateText}}</view><view class="schedule-subtitle"><text bindtap="openSettings">{{weekText}}</text><text>· {{todayName}}</text></view></view>
    <view class="schedule-actions"><button class="import-pill" bindtap="openImport">导入课表<image src="/assets/icons/chevron-down.png" /></button><button class="settings-button" bindtap="openSettings" aria-label="课表设置"><image src="/assets/icons/settings-2.png" /></button></view>
  </view>
  <view class="week-toolbar">
    <button class="week-arrow" bindtap="previousWeek" aria-label="上一周"><image src="/assets/icons/arrow-left.png" /></button>
    <view class="week-range">{{range}}<text wx:if="{{offset !== 0}}" bindtap="currentWeek">回本周</text></view>
    <button class="week-arrow" bindtap="nextWeek" aria-label="下一周"><image src="/assets/icons/arrow-right.png" /></button>
  </view>
  <view wx:if="{{error}}" class="schedule-status"><text>{{error}}</text><button bindtap="load">重试</button></view>
  <view wx:if="{{loading && !list.length}}" class="schedule-status">正在读取课表…</view>
  <view wx:elif="{{!list.length && !error}}" class="schedule-empty"><image src="/assets/icons/calendar-days-green.png" /><view>把这一周，安排清楚</view><text>从文件、照片或教务系统导入课表</text><button class="import-primary" bindtap="openImport">导入我的课表</button></view>
  <block wx:if="{{list.length}}">
    <view wx:if="{{!termStart}}" class="term-hint" bindtap="openSettings">设置开学日期，准确显示单双周课程<image src="/assets/icons/chevron-right-green.png" /></view>
    <view class="schedule-board">
      <view class="days-header"><view class="month-label">{{month}}<text>月</text></view><view class="day-heading {{item.today ? 'is-today' : ''}}" wx:for="{{days}}" wx:key="key"><text class="weekday-label">{{item.label}}</text><text class="day-date">{{item.date}}</text></view></view>
      <view class="timetable-body" style="height:{{gridHeight}}rpx">
        <view class="section-guide"><view wx:for="{{sections}}" wx:key="number" class="section-time" style="top:{{item.top}}rpx;height:{{item.height}}rpx"><text class="section-number">{{item.number}}</text><text>{{item.start}}</text><text>{{item.end}}</text></view></view>
        <view class="grid-area">
          <view wx:for="{{sections}}" wx:key="number" class="grid-row" style="top:{{item.top}}rpx;height:{{item.height}}rpx"><view wx:if="{{item.breakBefore}}" class="grid-break">{{item.breakBefore}}</view></view>
          <view class="course-column" wx:for="{{columns}}" wx:key="key" wx:for-item="column">
            <view wx:for="{{column.items}}" wx:key="id" class="course-block course-{{item.tone}} {{item.inactive ? 'course-inactive' : ''}} {{item.conflict ? 'course-conflict' : ''}}" style="top:{{item.top}}rpx;height:{{item.height}}rpx;left:{{item.left}};width:{{item.width}}" data-id="{{item.id}}" bindtap="editCourse" role="button" aria-label="{{item.name}}，周{{column.key}}，第{{item.startSect}}到{{item.endSect}}节，点击修改">
              <text wx:if="{{item.inactive}}" class="course-off-label">非本周</text><text class="course-start">{{item.time}}</text><text class="course-name">{{item.name}}</text><text wx:if="{{item.location}}" class="course-place">@{{item.location}}</text><text wx:if="{{item.teacher}}" class="course-teacher">{{item.teacher}}</text><text wx:if="{{item.conflict}}" class="course-overlap">重叠</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="schedule-footnote">{{termStart ? '本周' + activeCount + '条课程' : '全部课程'}} · 点击课程可修改<text wx:if="{{sections.length > 8}}"> · 晚课以教务时间为准</text></view>
  </block>

  <view wx:if="{{importOpen}}" class="sheet-mask" catchtap="closeImport" catchtouchmove="noop">
    <view class="schedule-sheet import-sheet" catchtap="noop"><view class="sheet-handle"></view><view class="sheet-title-row"><view class="sheet-title">导入课表</view><button class="sheet-close" disabled="{{importing}}" bindtap="closeImport" aria-label="关闭导入"><image src="/assets/icons/x.png" /></button></view>
      <view class="import-options">
        <button class="import-option" disabled="{{importing}}" bindtap="chooseFile"><view class="import-icon"><image src="/assets/icons/calendar-days-green.png" /></view><view><text class="option-title">文件导入</text><text class="option-description">Excel、CSV、ICS、JSON、PDF</text></view><image class="option-chevron" src="/assets/icons/chevron-right.png" /></button>
        <button class="import-option" disabled="{{importing}}" bindtap="choosePhoto"><view class="import-icon"><image src="/assets/icons/image-green.png" /></view><view><text class="option-title">照片导入</text><text class="option-description">拍照或选择完整、清晰的课表截图</text></view><image class="option-chevron" src="/assets/icons/chevron-right.png" /></button>
        <button class="import-option" disabled="{{importing}}" bindtap="importEducation"><view class="import-icon"><image src="/assets/icons/graduation-cap-green.png" /></view><view><text class="option-title">教务系统</text><text class="option-description">读取已关联教务的本学期课程</text></view><image class="option-chevron" src="/assets/icons/chevron-right.png" /></button>
      </view>
      <view wx:if="{{importing}}" class="import-progress">{{importLabel}}…<text>请稍等，识别完成后可逐项核对</text></view>
      <view wx:if="{{importError}}" class="sheet-error">{{importError}}</view>
      <button wx:if="{{!importing}}" class="education-link" bindtap="goAcademics">关联或管理教务账号</button>
      <view class="import-note">导入前可预览和修改，不会覆盖已有课程。照片与PDF中的文字将用于课表识别，请只上传课表内容。</view>
    </view>
  </view>

  <view wx:if="{{preview}}" class="sheet-mask" catchtap="closePreview" catchtouchmove="noop"><view class="schedule-sheet preview-sheet" catchtap="noop"><view class="sheet-handle"></view>
    <view class="sheet-title-row"><view><view class="sheet-title">核对导入课程</view><view class="sheet-subtitle">{{preview.label}} · {{previewRows.length}}条</view></view><button class="sheet-close" disabled="{{saving}}" bindtap="closePreview" aria-label="取消导入"><image src="/assets/icons/x.png" /></button></view>
    <scroll-view scroll-y class="preview-scroll"><view wx:if="{{previewWarnings.length}}" class="preview-warnings"><text wx:for="{{previewWarnings}}" wx:key="*this">{{item}}</text></view>
      <view class="preview-course" wx:for="{{previewRows}}" wx:key="index"><view class="preview-main" data-preview="{{index}}" bindtap="editCourse"><view class="preview-name">{{item.name}}</view><view>{{item.summary}}<text wx:if="{{item.weeks}}"> · {{item.weeks}}周</text></view><view wx:if="{{item.location || item.teacher}}">{{item.location}} {{item.teacher}}</view><view wx:if="{{item.issue}}" class="sheet-error">{{item.issue}}</view></view><button class="preview-edit" data-preview="{{index}}" bindtap="editCourse" disabled="{{saving}}">修改</button><button class="preview-remove" data-index="{{index}}" bindtap="removePreview" disabled="{{saving}}" aria-label="移除此条待导入课程"><image src="/assets/icons/x.png" /></button></view>
      <view wx:if="{{!previewRows.length}}" class="preview-empty">没有待导入课程，可关闭后重新选择</view>
    </scroll-view>
    <view wx:if="{{importError}}" class="sheet-error">{{importError}}</view><button class="import-primary" bindtap="confirmImport" disabled="{{saving || !previewRows.length}}">{{saving ? '正在保存…' : '确认导入 ' + previewRows.length + ' 条课程'}}</button><view class="import-note">相同课程自动跳过，原课表会保留。</view>
  </view></view>

  <view wx:if="{{settingsOpen}}" class="sheet-mask" catchtap="closeSettings" catchtouchmove="noop"><view class="schedule-sheet" catchtap="noop"><view class="sheet-handle"></view><view class="sheet-title-row"><view class="sheet-title">课表设置</view><button class="sheet-close" bindtap="closeSettings" disabled="{{saving}}" aria-label="关闭设置"><image src="/assets/icons/x.png" /></button></view>
    <view class="setting-row"><view><view class="setting-name">本学期开学日期</view><view class="setting-description">所在周按第1周计算</view></view><picker mode="date" value="{{termStart}}" start="2000-01-01" end="2100-12-31" bindchange="onTermStart" disabled="{{saving}}"><view class="setting-value">{{termStart || '选择日期'}}</view></picker></view>
    <view class="setting-row"><view><view class="setting-name">显示非本周课程</view><view class="setting-description">以淡色标记，方便查看完整学期</view></view><switch checked="{{showInactive}}" bindchange="onInactive" color="#2164B5" /></view>
    <view class="time-reference"><view>上课时间</view><text>1  08:00–08:45　2  08:55–09:40</text><text>3  10:10–10:55　4  11:05–11:50</text><text>5  14:00–14:45　6  14:55–15:40</text><text>7  16:10–16:55　8  17:05–17:50</text></view><view wx:if="{{settingsError}}" class="sheet-error">{{settingsError}}</view>
  </view></view>

  <view wx:if="{{editing}}" class="sheet-mask editor-mask" catchtap="closeEditor" catchtouchmove="noop"><view class="schedule-sheet editor-sheet" catchtap="noop"><view class="sheet-handle"></view><view class="sheet-title-row"><view class="sheet-title">修改课程</view><button class="sheet-close" disabled="{{saving}}" bindtap="closeEditor" aria-label="取消修改"><image src="/assets/icons/x.png" /></button></view>
    <scroll-view scroll-y class="editor-scroll"><view class="editor-field"><text>课程名称</text><input class="editor-input" value="{{form.name}}" data-field="name" bindinput="onField" maxlength="128" adjust-position cursor-spacing="24" /></view>
    <view class="editor-two"><view class="editor-field"><text>教室</text><input class="editor-input" value="{{form.location}}" data-field="location" bindinput="onField" maxlength="128" placeholder="可留空" adjust-position cursor-spacing="24" /></view><view class="editor-field"><text>教师</text><input class="editor-input" value="{{form.teacher}}" data-field="teacher" bindinput="onField" maxlength="64" placeholder="可留空" adjust-position cursor-spacing="24" /></view></view>
    <view class="editor-two editor-pickers"><picker range="{{weekdayNames}}" value="{{form.weekday - 1}}" data-field="weekday" bindchange="onPicker"><view class="editor-input">{{weekdayNames[form.weekday - 1]}}</view></picker><picker range="{{sectionsRange}}" value="{{form.startSect - 1}}" data-field="startSect" bindchange="onPicker"><view class="editor-input">第{{form.startSect}}节起</view></picker><picker range="{{sectionsRange}}" value="{{form.endSect - 1}}" data-field="endSect" bindchange="onPicker"><view class="editor-input">第{{form.endSect}}节止</view></picker></view>
    <view class="editor-field"><text>上课周次</text><input class="editor-input" value="{{form.weeks}}" data-field="weeks" bindinput="onField" maxlength="64" placeholder="如1-16、1-16(单)；留空为每周" adjust-position cursor-spacing="24" /></view><view wx:if="{{editError}}" class="sheet-error">{{editError}}</view></scroll-view>
    <view class="editor-footer"><button wx:if="{{editing.id}}" class="delete-course" disabled="{{saving}}" bindtap="deleteCourse">删除课程</button><button class="import-primary" bindtap="saveCourse" disabled="{{saving}}">{{saving ? '正在保存…' : '保存修改'}}</button></view>
  </view></view>
</view>
