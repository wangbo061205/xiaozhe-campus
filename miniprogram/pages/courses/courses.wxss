.schedule-root { padding-bottom: 48rpx; font-variant-numeric: tabular-nums; }
.schedule-heading { margin: 28rpx 24rpx 16rpx; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.schedule-date { color: var(--ink); font-size: 42rpx; font-weight: 650; line-height: 1.25; letter-spacing: -1rpx; }
.schedule-subtitle { display: flex; gap: 12rpx; color: var(--ink-2); font-size: 26rpx; line-height: 44rpx; }
.schedule-actions { display: flex; align-items: center; gap: 8rpx; }
.schedule-root button.import-pill, .schedule-root button.settings-button, .schedule-root button.week-arrow { display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,.72); border: 1px solid rgba(255,255,255,.9); backdrop-filter: blur(18px) saturate(145%); -webkit-backdrop-filter: blur(18px) saturate(145%); box-shadow: 0 2rpx 6rpx rgba(28,65,110,.03), 0 8rpx 20rpx rgba(28,65,110,.05), inset 0 0 0 1rpx rgba(255,255,255,.4); }
.schedule-root button.import-pill { min-height: 88rpx; padding: 0 20rpx; gap: 8rpx; font-size: 25rpx; color: var(--ink); border-radius: 44rpx; white-space: nowrap; }
.import-pill image { width: 26rpx; height: 26rpx; }
.schedule-root button.settings-button { width: 88rpx; height: 88rpx; padding: 0; border-radius: 50%; }
.settings-button image { width: 36rpx; height: 36rpx; }
.week-toolbar { margin: 0 20rpx 12rpx; display: flex; align-items: center; justify-content: space-between; }
.schedule-root button.week-arrow { height: 88rpx; width: 88rpx; padding: 0; border-radius: 50%; background: transparent; border-color: transparent; box-shadow: none; }
.week-arrow image { width: 32rpx; height: 32rpx; }
.week-range { display: flex; align-items: center; justify-content: center; gap: 12rpx; font-size: 24rpx; color: var(--ink-2); }
.week-range text { font-size: 23rpx; color: var(--campus-accent-ink); padding: 16rpx 4rpx; }
.schedule-status { margin: 16rpx 24rpx; display: flex; gap: 16rpx; align-items: center; justify-content: center; color: var(--ink-2); font-size: 26rpx; padding: 24rpx 0; }
.schedule-status text { flex: 1; }
.schedule-status button { font-size: 25rpx; color: var(--campus-accent-ink); background: var(--campus-tone-blue); border-radius: 32rpx; padding: 12rpx 28rpx; }
.schedule-empty { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 140rpx 32rpx 180rpx; }
.schedule-empty image { width: 76rpx; height: 76rpx; margin-bottom: 30rpx; }
.schedule-empty>view { font-size: 36rpx; font-weight: 600; color: var(--ink); }
.schedule-empty>text { margin: 14rpx 0 40rpx; font-size: 27rpx; color: var(--ink-2); }
.schedule-empty .import-primary { width: 320rpx; }
.term-hint { margin: 0 24rpx 20rpx; font-size: 24rpx; color: var(--campus-accent-ink); display: flex; align-items: center; justify-content: space-between; padding: 14rpx 16rpx; background: var(--campus-tone-blue); border-radius: 16rpx; }
.term-hint image { width: 28rpx; height: 28rpx; }
.schedule-board { margin: 0 12rpx 0 8rpx; }
.days-header { display: flex; align-items: center; height: 110rpx; margin-bottom: 8rpx; }
.month-label { width: 76rpx; flex: 0 0 76rpx; text-align: center; font-size: 29rpx; color: var(--ink); font-weight: 600; line-height: 32rpx; }
.month-label text { display: block; font-size: 22rpx; font-weight: 400; }
.day-heading { flex: 1; text-align: center; min-width: 0; color: var(--ink-2); display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.weekday-label { font-size: 25rpx; line-height: 32rpx; }
.day-date { font-size: 29rpx; font-weight: 550; width: 54rpx; height: 54rpx; line-height: 54rpx; border-radius: 50%; }
.is-today .weekday-label { color: var(--campus-accent-ink); font-weight: 600; }
.is-today .day-date { background: var(--primary); color: var(--campus-on-accent); }
.timetable-body { position: relative; }
.section-guide { position: absolute; left: 0; top: 0; width: 76rpx; height: 100%; }
.section-time { position: absolute; width: 100%; padding-top: 18rpx; display: flex; flex-direction: column; align-items: center; color: var(--ink-2); font-size: 22rpx; line-height: 30rpx; }
.section-number { font-size: 28rpx; font-weight: 600; color: var(--ink); margin-bottom: 8rpx; }
.grid-area { position: absolute; left: 76rpx; right: 0; top: 0; height: 100%; display: flex; }
.grid-row { position: absolute; left: 0; width: 100%; border-top: 1rpx dashed rgba(82,103,129,.19); pointer-events: none; }
.grid-break { position: absolute; top: -24rpx; left: 0; width: 100%; height: 24rpx; text-align: center; color: var(--ink-2); font-size: 20rpx; line-height: 24rpx; letter-spacing: 6rpx; }
.course-column { position: relative; flex: 1; min-width: 0; border-left: 1rpx dashed rgba(82,103,129,.13); height: 100%; }
.course-column:last-child { border-right: 1rpx dashed rgba(82,103,129,.13); }
.course-block { position: absolute; overflow: hidden; border-radius: 13rpx; padding: 12rpx 7rpx; display: flex; flex-direction: column; align-items: center; text-align: center; font-size: 22rpx; line-height: 29rpx; word-break: break-all; box-shadow: 0 2rpx 3rpx rgba(45,75,115,.03), 0 6rpx 12rpx rgba(45,75,115,.045); }
.course-block>text { display: block; flex-shrink: 0; max-width: 100%; }
.course-start { font-size: 22rpx; font-weight: 600; line-height: 28rpx; }
.course-name { font-weight: 600; margin: 4rpx 0 8rpx; }
.course-place { font-size: 22rpx; line-height: 28rpx; }
.course-teacher { margin-top: 10rpx; font-size: 22rpx; line-height: 28rpx; }
.course-blue { background: #D5E7FF; color: #194D88; }
.course-sky { background: #DCEEF8; color: #1E526A; }
.course-teal { background: #DDF0ED; color: #245C55; }
.course-indigo { background: #E4E4F7; color: #464577; }
.course-slate { background: #E0E8F2; color: #394F6C; }
.course-inactive { background: #E8EDF3; color: #52647B; border: 1rpx dashed #A0B1C7; box-shadow: none; }
.course-off-label, .course-overlap { font-size: 20rpx; line-height: 25rpx; }
.course-conflict { padding-left: 2rpx; padding-right: 2rpx; }
.schedule-footnote { margin: 26rpx 24rpx 0; text-align: center; color: var(--ink-2); font-size: 22rpx; line-height: 36rpx; }
.sheet-mask { position: fixed; inset: 0; z-index: 500; background: rgba(24,42,64,.26); display: flex; align-items: flex-end; justify-content: center; }
.schedule-sheet { width: 100%; max-height: 88vh; border-radius: 40rpx 40rpx 0 0; padding: 14rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); background: var(--campus-surface); box-shadow: 0 -8rpx 40rpx rgba(31,58,90,.08); }
.sheet-handle { width: 64rpx; height: 8rpx; background: var(--campus-line); border-radius: 8rpx; margin: 0 auto 12rpx; }
.sheet-title-row { display: flex; justify-content: space-between; align-items: center; margin: 0 0 20rpx; min-height: 84rpx; gap: 16rpx; }
.sheet-title { font-size: 36rpx; font-weight: 600; line-height: 48rpx; color: var(--ink); }
.sheet-subtitle { font-size: 24rpx; color: var(--ink-2); max-width: 530rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.schedule-root button.sheet-close { width: 88rpx; height: 88rpx; padding: 0; border-radius: 50%; background: var(--campus-canvas); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.sheet-close image { width: 34rpx; height: 34rpx; }
.import-options { display: flex; flex-direction: column; gap: 10rpx; }
.schedule-root button.import-option { display: flex; align-items: center; text-align: left; padding: 20rpx 8rpx; min-height: 120rpx; width: 100%; border-radius: 20rpx; background: transparent; box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; color: var(--ink); gap: 22rpx; }
.import-option[disabled] { opacity: .5; }
.import-icon { width: 80rpx; height: 80rpx; background: var(--campus-tone-blue); border-radius: 24rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 80rpx; }
.import-icon image { width: 40rpx; height: 40rpx; }
.import-option>view:nth-child(2) { flex: 1; min-width: 0; }
.option-title, .option-description { display: block; }
.option-title { font-size: 30rpx; line-height: 44rpx; font-weight: 550; }
.option-description { font-size: 23rpx; line-height: 36rpx; color: var(--ink-2); }
.option-chevron { width: 30rpx; height: 30rpx; flex-shrink: 0; }
.schedule-root button.education-link { width: 100%; background: transparent; box-shadow: none; color: var(--campus-accent-ink); padding: 24rpx 0 10rpx; font-size: 26rpx; min-height: 88rpx; }
.import-note { font-size: 22rpx; line-height: 35rpx; color: var(--ink-2); margin-top: 18rpx; }
.import-progress { font-size: 28rpx; padding: 20rpx 0; color: var(--campus-accent-ink); }
.import-progress text { display: block; font-size: 24rpx; color: var(--ink-2); }
.sheet-error { font-size: 25rpx; color: var(--danger); padding: 14rpx 0; line-height: 38rpx; }
.schedule-root button.import-primary { min-height: 88rpx; border-radius: 28rpx; padding: 22rpx 28rpx; font-size: 29rpx; line-height: 42rpx; font-weight: 600; color: var(--campus-on-accent); background: var(--primary); width: 100%; }
.import-primary[disabled] { opacity: .5; }
.preview-scroll { height: 54vh; margin: 0 0 20rpx; }
.preview-warnings { background: var(--campus-canvas); border-radius: 20rpx; padding: 18rpx; margin-bottom: 12rpx; }
.preview-warnings text { display: block; font-size: 23rpx; line-height: 36rpx; color: var(--ink-2); }
.preview-course { display: flex; gap: 8rpx; padding: 22rpx 0; align-items: center; border-bottom: 1rpx solid var(--campus-line); }
.preview-main { flex: 1; min-width: 0; font-size: 23rpx; line-height: 35rpx; color: var(--ink-2); }
.preview-name { color: var(--ink); font-size: 29rpx; line-height: 42rpx; font-weight: 550; }
.schedule-root button.preview-edit { color: var(--campus-accent-ink); background: transparent; box-shadow: none; font-size: 25rpx; padding: 20rpx 8rpx; }
.schedule-root button.preview-remove { width: 64rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; background: transparent; box-shadow: none; padding: 0; }
.preview-remove image { width: 28rpx; height: 28rpx; }
.preview-empty { padding: 80rpx 0; text-align: center; font-size: 27rpx; color: var(--ink-2); }
.setting-row { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--campus-line); }
.setting-name { font-size: 29rpx; line-height: 42rpx; color: var(--ink); }
.setting-description { font-size: 23rpx; color: var(--ink-2); }
.setting-value { font-size: 26rpx; color: var(--campus-accent-ink); padding: 16rpx 0; }
.time-reference { padding: 28rpx 0 12rpx; color: var(--ink-2); font-size: 25rpx; line-height: 46rpx; }
.time-reference>view { color: var(--ink); font-size: 28rpx; margin-bottom: 10rpx; }
.time-reference text { display: block; }
.editor-mask { z-index: 600; }
.editor-scroll { max-height: 52vh; height: 570rpx; }
.editor-field { margin-bottom: 24rpx; flex: 1; min-width: 0; }
.editor-field>text { display: block; margin-bottom: 12rpx; font-size: 25rpx; color: var(--ink-2); }
.editor-input { height: 88rpx; line-height: 88rpx; width: 100%; padding: 0 20rpx; border-radius: 20rpx; background: var(--campus-canvas); color: var(--ink); font-size: 27rpx; }
.editor-two { display: flex; gap: 16rpx; }
.editor-pickers { margin-bottom: 24rpx; }
.editor-pickers picker { flex: 1; min-width: 0; }
.editor-pickers .editor-input { padding: 0 14rpx; text-align: center; }
.editor-footer { display: flex; gap: 20rpx; margin-top: 20rpx; align-items: center; }
.editor-footer .import-primary { flex: 1; width: 0; }
.schedule-root button.delete-course { padding: 22rpx 12rpx; background: transparent; box-shadow: none; color: var(--danger); font-size: 27rpx; line-height: 44rpx; }
.schedule-root.gq-low button.import-pill, .schedule-root.gq-low button.settings-button, .schedule-root.gq-low button.week-arrow { background: var(--campus-surface); backdrop-filter: none; -webkit-backdrop-filter: none; border-color: var(--campus-line); }
@media (prefers-reduced-transparency: reduce) { .schedule-root button.import-pill, .schedule-root button.settings-button, .schedule-root button.week-arrow { background: var(--campus-surface); backdrop-filter: none; -webkit-backdrop-filter: none; } }
@media (max-width: 340px) { .schedule-date { font-size: 36rpx; } .import-pill { padding: 0 16rpx; } .settings-button { width: 76rpx; } }
.schedule-root .schedule-empty button.import-primary { width: 320rpx; }
