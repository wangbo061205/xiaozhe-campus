<view class="root detail-root {{gq}}">
  <glass-bg /><glass-nav title="{{pageTitle}}" back />
  <view wx:if="{{loading}}" class="state-box">正在加载</view>
  <view wx:elif="{{error}}" class="state-box"><image src="/assets/icons/book-open.png" /><view class="state-title">{{error}}</view><view class="state-action" bindtap="load">重新加载</view></view>
  <block wx:elif="{{item}}">
    <image wx:if="{{item.cover}}" class="detail-cover" src="{{item.cover}}" mode="aspectFill" data-src="{{item.cover}}" bindtap="preview" binderror="onCoverError" />
    <view class="detail-intro"><view class="detail-type">{{pageTitle}}</view><view class="detail-title">{{item.title}}</view><view wx:if="{{item.subtitle}}" class="detail-subtitle">{{item.subtitle}}</view><view wx:if="{{item.description && !content}}" class="detail-description">{{item.description}}</view><view class="detail-source">小北云校园<text wx:if="{{item.dateText}}"> · {{item.dateText}}</text></view></view>
    <view wx:if="{{fields.length}}" class="surface-section"><view class="detail-field" wx:for="{{fields}}" wx:key="label"><text class="field-label">{{item.label}}</text><text class="field-value" selectable>{{item.value}}</text></view></view>
    <view wx:if="{{content}}" class="surface-section detail-rich"><rich-text nodes="{{content}}" user-select /></view>
    <view wx:if="{{floors.length}}" class="surface-section"><view class="section-title">楼层平面图</view><scroll-view scroll-x class="floor-tabs"><text wx:for="{{floors}}" wx:key="id" class="floor-tab {{floorIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onFloor">{{item.label}}</text></scroll-view><image wx:if="{{floors[floorIndex].image}}" class="floor-image" src="{{floors[floorIndex].image}}" mode="widthFix" data-src="{{floors[floorIndex].image}}" bindtap="preview" /><view wx:else class="state-box">该楼层暂未提供平面图</view><view wx:for="{{floors[floorIndex].rooms}}" wx:key="viewKey" class="room-row">{{item.title}}<text>{{item.description}}</text></view></view>
    <view wx:if="{{images.length}}" class="surface-section"><image wx:for="{{images}}" wx:key="*this" class="detail-image" src="{{item}}" mode="widthFix" data-src="{{item}}" bindtap="preview" /></view>
    <view wx:if="{{relatedTitle}}" class="surface-section"><view class="section-title">{{relatedTitle}}</view><view wx:if="{{relatedError}}" class="subtle">{{relatedError}}</view><view wx:elif="{{!related.length}}" class="subtle">暂无内容</view><view wx:for="{{related}}" wx:key="viewKey" class="related-item"><view>{{item.title}}</view><view class="subtle">{{item.description}}</view></view></view>
    <view wx:if="{{type === 'comment-room'}}" class="surface-section"><view class="section-title">话题留言</view><view wx:if="{{relatedError}}" class="subtle">{{relatedError}}</view><view wx:if="{{!comments.length && !commentLoading}}" class="state-box">暂无留言</view><view class="comment-row" wx:for="{{comments}}" wx:key="id"><view class="comment-meta"><text>{{item.name}}</text><text>{{item.date}}</text></view><view class="comment-content" selectable>{{item.content}}</view></view><view wx:if="{{commentMore}}" class="state-action" bindtap="moreComments">{{commentLoading ? '正在加载' : '更多留言'}}</view><view class="unavailable">评论暂未开放</view></view>
    <view wx:if="{{type === 'activity' || type === 'lottery'}}" class="availability-footer"><button disabled>{{type === 'activity' ? '报名与签到暂未开放' : '抽奖暂未开放'}}</button></view>
    <view wx:if="{{canNavigate}}" class="detail-map-action"><button class="btn-primary" bindtap="goMap"><image class="icon-sm" src="/assets/icons/navigation-on-accent.png" />在校园地图中查看</button></view>
  </block>
</view>
