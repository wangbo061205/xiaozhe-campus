.detail-root { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }.detail-cover { width: 100%; height: 400rpx; display: block; }.detail-intro { background: var(--campus-surface); padding: 34rpx 34rpx 28rpx; border-bottom: 14rpx solid var(--campus-line); }.detail-type { font-size: 23rpx; color: var(--campus-accent-ink); margin-bottom: 14rpx; }.detail-title { font-size: 36rpx; font-weight: 600; line-height: 1.55; word-break: break-all; }.detail-subtitle { font-size: 24rpx; color: var(--ink-2); margin-top: 16rpx; }.detail-description { font-size: var(--body-size); line-height: 1.9; margin-top: 20rpx; color: var(--ink-2); white-space: pre-wrap; }.detail-source { color: var(--ink-2); font-size: 21rpx; margin-top: 24rpx; }.detail-field { display: flex; gap: 28rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--campus-line); align-items: baseline; }.detail-field:last-child { border-bottom: 0; }.field-label { width: 170rpx; flex-shrink: 0; color: var(--ink-2); font-size: 24rpx; }.field-value { flex: 1; min-width: 0; font-size: 26rpx; white-space: pre-wrap; word-break: break-all; }.detail-rich { font-size: 28rpx; line-height: 1.95; color: var(--ink); overflow: hidden; word-break: break-all; }.detail-image { display: block; width: 100%; margin-bottom: 20rpx; border-radius: var(--content-radius); }.related-item { padding: 18rpx 0; border-bottom: 1rpx solid var(--campus-line); font-size: 27rpx; }.related-item .subtle { margin-top: 10rpx; }.detail-map-action { position: fixed; bottom: 0; left: 0; right: 0; background: var(--campus-surface); padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); z-index: 15; border-top: 1rpx solid var(--campus-line); }.detail-map-action button { display: flex; justify-content: center; align-items: center; gap: 12rpx; height: 88rpx; padding: 0; font-size: 28rpx; }.availability-footer { padding: 20rpx 32rpx; }.availability-footer button { font-size: 26rpx; padding: 18rpx; border-radius: var(--content-radius); }.comment-row { padding: 24rpx 0; border-bottom: 1rpx solid var(--campus-line); }.comment-meta { display: flex; justify-content: space-between; gap: 20rpx; font-size: 22rpx; color: var(--ink-2); }.comment-content { margin-top: 12rpx; font-size: var(--body-size); line-height: 1.8; white-space: pre-wrap; }.unavailable { padding: 24rpx 0; color: var(--ink-2); font-size: 22rpx; }.floor-tabs { white-space: nowrap; margin-bottom: 24rpx; }.floor-tab { display: inline-block; padding: 12rpx 26rpx; margin-right: 12rpx; border-radius: var(--content-radius); background: var(--campus-tone-green); font-size: 24rpx; }.floor-tab.active { background: var(--primary); color: var(--campus-on-accent); }.floor-image { width: 100%; display: block; }.room-row { padding: 20rpx 0; border-bottom: 1rpx solid var(--campus-line); font-size: 26rpx; }.room-row text { display: block; font-size: 22rpx; color: var(--ink-2); }
.detail-intro { padding-left: var(--page-gutter); padding-right: var(--page-gutter); }
.detail-field { gap: 24rpx; }
.field-label { width: var(--field-label-width); line-height: 42rpx; }
.field-value { line-height: 42rpx; text-align: left; }
.detail-map-action { padding-left: var(--page-gutter); padding-right: var(--page-gutter); }

/* Selected design overrides. */
.detail-map-action button { color: var(--campus-on-accent); }
.detail-intro { border-bottom-width: var(--section-gap); }
.floor-tab.active { background: var(--primary); color: var(--campus-on-accent); }
