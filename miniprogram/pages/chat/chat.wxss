.root.chat-root {
  --page-gutter: 40rpx;
  --chat-glass-fill: rgba(var(--glass-rgb), .6);
  --chat-glass-filter: blur(18px) saturate(160%);
  --chat-glass-shadow: 0 2px 4px rgba(24,50,83,.025), 0 12px 28px rgba(24,50,83,.07), inset 0 0 0 1px rgba(255,255,255,.9), inset 2px 1px 2px rgba(255,255,255,.55), inset -1px -2px 2px rgba(54,92,143,.08);
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 0;
  padding-bottom: 0;
  overflow: hidden;
}
.chat-scroll-clip { position: relative; flex: 1; height: 0; min-height: 0; overflow: hidden; contain: paint; }
.chat-body { width: 100%; height: 100%; }
.msg-list { padding: 40rpx var(--page-gutter) 0; }
.msg-list--welcome { padding-top: 64rpx; }
.msg { display: flex; align-items: flex-start; gap: 20rpx; margin-bottom: 36rpx; }
.msg-avatar { display: block; flex-shrink: 0; width: 64rpx; height: 64rpx; border-radius: 50%; background: #EDF6F8; }
.msg-bubble { min-width: 0; max-width: calc(100% - 84rpx); padding: 4rpx 0; font-size: 32rpx; line-height: 1.8; color: var(--ink); }
.msg-text { white-space: pre-wrap; overflow-wrap: break-word; word-break: break-word; }
.msg-user { justify-content: flex-end; }
.msg-user .msg-bubble { max-width: 85%; padding: 18rpx 28rpx; border-radius: 32rpx 32rpx 10rpx 32rpx; background: var(--campus-tone-blue); }
.msg--welcome { flex-direction: column; gap: 28rpx; margin-bottom: 32rpx; }
.msg--welcome .msg-avatar { width: 136rpx; height: 136rpx; animation: chat-reveal 300ms var(--ease) backwards; }
.msg--welcome .msg-bubble { max-width: 100%; padding: 0; animation: chat-reveal 300ms var(--ease) 55ms backwards; }
.msg-src { display: flex; flex-direction: column; gap: 6rpx; margin-top: 16rpx; white-space: normal; }
.chat-root button.msg-src-item { display: flex; align-items: center; gap: 16rpx; width: 100%; min-height: 44px; margin: 0; padding: 10rpx 0; border: 0; border-radius: 0; color: var(--campus-accent-ink); background: transparent; background-image: none; box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; text-align: left; font-size: 25rpx; line-height: 1.6; }
.msg-src-title { flex: 1; min-width: 0; overflow-wrap: break-word; }
.msg-src-icon { display: block; flex-shrink: 0; width: 26rpx; height: 26rpx; opacity: .7; }
.typing { display: flex; align-items: center; gap: 10rpx; min-height: 64rpx; }
.typing .dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: var(--ink-2); animation: chat-thinking 1.2s infinite; }
.typing .d2 { animation-delay: .16s; }
.typing .d3 { animation-delay: .32s; }
.suggest-area { display: flex; flex-direction: column; gap: 4rpx; padding-bottom: 12rpx; }
.chat-root button.suggest-chip { display: flex; align-items: center; gap: 24rpx; width: 100%; min-height: 48px; margin: 0; padding: 14rpx 0; border: 0; border-radius: 0; background: transparent; background-image: none; box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; color: var(--ink-2); text-align: left; font-size: 28rpx; line-height: 1.6; animation: chat-reveal 300ms var(--ease) 100ms backwards; transition: opacity 140ms ease; }
.suggest-text { flex: 1; min-width: 0; overflow-wrap: break-word; }
.suggest-arrow { display: block; width: 28rpx; height: 28rpx; flex-shrink: 0; opacity: .55; }
.chat-root .suggest-chip:nth-child(2) { animation-delay: 145ms; }
.chat-root .suggest-chip:nth-child(3) { animation-delay: 190ms; }
.chat-root .suggest-chip:nth-child(4) { animation-delay: 235ms; }
.chat-root .suggest-chip:nth-child(5) { animation-delay: 280ms; }
.chat-root .suggest-chip:nth-child(6) { animation-delay: 325ms; }
.chat-control--pressed { opacity: .55; }
.bottom-anchor { height: 24rpx; }
.composer-wrap { flex-shrink: 0; padding: 12rpx var(--page-gutter) calc(var(--tab-space) + 12rpx); }
.chat-root--keyboard .composer-wrap { padding-bottom: 24px; }
.chat-root .composer { display: flex; align-items: center; gap: 12rpx; height: 56px; padding: 6px 6px 6px 20px; border: 0; border-radius: 28px; background-color: var(--chat-glass-fill); background-image: linear-gradient(rgba(255,255,255,.1),rgba(255,255,255,.1)); box-shadow: var(--chat-glass-shadow); backdrop-filter: var(--chat-glass-filter); -webkit-backdrop-filter: var(--chat-glass-filter); transition: box-shadow 180ms ease, background-color 180ms ease; }
.chat-root .composer--focused { box-shadow: var(--chat-glass-shadow), 0 0 0 1px rgba(33,100,181,.2); }
.composer-field { flex: 1; min-width: 0; }
.chat-input { width: 100%; height: 44px; line-height: 44px; padding: 0; font-size: 32rpx; color: var(--ink); caret-color: var(--campus-accent); }
.ph { color: var(--ink-3); }
.chat-root button.send-btn { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 44px; height: 44px; min-height: 44px; margin: 0; padding: 0; border: 0; border-radius: 22px; color: #FFF; background-color: var(--campus-accent); background-image: linear-gradient(rgba(255,255,255,.1),rgba(255,255,255,.1)); box-shadow: 0 2px 5px rgba(33,100,181,.12), inset 0 0 0 1px rgba(255,255,255,.4); backdrop-filter: none; -webkit-backdrop-filter: none; transition: transform 140ms var(--ease), opacity 140ms ease; }
.chat-root button.send-btn[disabled] { background: var(--campus-tone-blue) !important; color: var(--ink-2) !important; box-shadow: none !important; opacity: 1; }
.send-icon { display: block; width: 24px; height: 24px; transform: rotate(90deg); }
.send-progress { font-size: 26px; line-height: 1; transform: translateY(-4px); }
.send-btn--pressed { transform: scale(.94); }
.chat-root.gq-low { --chat-glass-fill: var(--campus-surface); --chat-glass-filter: none; --chat-glass-shadow: 0 2px 4px rgba(24,50,83,.025), 0 8px 20px rgba(24,50,83,.065), inset 0 0 0 1px rgba(255,255,255,.8); }
.chat-root.high-contrast { --chat-glass-fill: var(--campus-surface); --chat-glass-filter: none; --chat-glass-shadow: inset 0 0 0 1px var(--ink-2); }
.chat-root.high-contrast .msg-user .msg-bubble { box-shadow: inset 0 0 0 1px var(--ink-2); }
.chat-root.motion-reduced .msg-avatar, .chat-root.motion-reduced .msg-bubble, .chat-root.motion-reduced .suggest-chip, .chat-root.motion-reduced .dot, .chat-root.gq-low .msg-avatar, .chat-root.gq-low .msg-bubble, .chat-root.gq-low .suggest-chip, .chat-root.gq-low .dot { animation: none; }
.chat-root.motion-reduced .composer, .chat-root.motion-reduced button, .chat-root.gq-low .composer, .chat-root.gq-low button { transition: none; }
@keyframes chat-reveal { from { opacity: 0; transform: translateY(8rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes chat-thinking { 0%,60%,100% { opacity: .35; } 30% { opacity: 1; } }
@media (prefers-reduced-motion: reduce) {
  .msg--welcome .msg-avatar, .msg--welcome .msg-bubble, .chat-root button.suggest-chip, .typing .dot { animation: none; }
  .chat-root .composer, .chat-root button { transition: none; }
}
@media (prefers-reduced-transparency: reduce) {
  .root.chat-root { --chat-glass-fill: var(--campus-surface); --chat-glass-filter: none; }
}
@media (prefers-contrast: more) {
  .root.chat-root { --chat-glass-fill: var(--campus-surface); --chat-glass-filter: none; --chat-glass-shadow: inset 0 0 0 1px var(--ink-2); }
  .msg-user .msg-bubble { box-shadow: inset 0 0 0 1px var(--ink-2); }
}
