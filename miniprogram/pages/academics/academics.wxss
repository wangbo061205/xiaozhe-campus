.academic-root { padding-bottom: 60rpx; }.academic-header { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 34rpx 32rpx; background: var(--campus-surface); }.academic-title { font-size: 40rpx; font-weight: 600; }.academic-heading-action { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: var(--campus-accent-ink); }.academic-tabs { display: flex; background: var(--campus-surface); border-bottom: 1rpx solid var(--campus-line); }.academic-tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; border-bottom: 5rpx solid transparent; color: var(--ink-2); }.academic-tab.active { color: var(--campus-accent-ink); border-bottom-color: var(--campus-line); font-weight: 600; }.academic-error { margin: 22rpx 26rpx; padding: 20rpx; border-radius: var(--content-radius); background: var(--campus-tone-orange); color: var(--signal-ink); font-size: 25rpx; line-height: 1.8; word-break: break-all; }.academic-error>text { display: block; color: var(--campus-accent-ink); padding-top: 8rpx; }.binding-form .segment { margin-bottom: 30rpx; }.binding-form .form-item { margin-top: 28rpx; }.binding-title { font-size: var(--body-size); font-weight: 500; }.binding-row { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--campus-line); }.binding-row>view { flex: 1; min-width: 0; }.binding-row .subtle { font-size: 22rpx; margin-top: 5rpx; }.unlink-button { color: var(--signal-ink); border: 1rpx solid var(--campus-line); background: var(--campus-surface); font-size: 23rpx; padding: 12rpx 24rpx; border-radius: var(--content-radius); flex-shrink: 0; }.bind-submit { margin-top: 28rpx; }.captcha-row { display: flex; align-items: center; gap: 16rpx; }.captcha-row input { flex: 1; min-width: 0; }.captcha-image-box { width: 220rpx; height: 84rpx; flex-shrink: 0; background: var(--campus-tone-green); display: flex; align-items: center; justify-content: center; color: var(--campus-accent-ink); font-size: 24rpx; border-radius: var(--content-radius); }.captcha-image-box image { width: 100%; height: 100%; }.captcha-error { font-size: 22rpx; color: var(--signal-ink); margin-top: 12rpx; }.consent-row { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; margin-top: 24rpx; }.consent-row checkbox { transform: scale(.78); }.privacy-note { font-size: 22rpx; line-height: 1.8; color: var(--ink-2); margin-top: 16rpx; }.data-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 26rpx 32rpx; background: var(--campus-surface); margin-top: 14rpx; }.semester-label { display: flex; align-items: center; font-size: 25rpx; gap: 10rpx; color: var(--ink-2); word-break: break-all; }.sync-action { display: flex; align-items: center; font-size: 24rpx; gap: 8rpx; color: var(--campus-accent-ink); flex-shrink: 0; }.week-strip { display: flex; background: var(--campus-surface); padding: 0 20rpx 26rpx; gap: 8rpx; }.week-day { flex: 1; min-width: 0; text-align: center; padding: 17rpx 0; font-size: 24rpx; border-radius: var(--content-radius); color: var(--ink-2); }.week-day.active { background: var(--primary); color: var(--campus-on-accent); }.course-row { display: flex; align-items: stretch; gap: 22rpx; background: var(--campus-surface); padding: 30rpx; margin-top: 14rpx; }.course-section { width: 76rpx; flex-shrink: 0; border-right: 4rpx solid var(--campus-line); color: var(--campus-accent-ink); font-size: 28rpx; padding-right: 12rpx; text-align: center; }.course-section>view { font-size: 22rpx; margin-top: 4rpx; color: var(--ink-2); }.course-main { flex: 1; min-width: 0; }.course-name { font-size: var(--body-size); font-weight: 600; }.course-classroom { display: flex; gap: 8rpx; align-items: center; font-size: 24rpx; color: var(--campus-accent-ink); margin-top: 12rpx; }.course-meta { font-size: 22rpx; color: var(--ink-2); margin-top: 8rpx; }.grade-record { padding: 28rpx 32rpx; background: var(--campus-surface); margin-top: 14rpx; }.grade-name { font-size: var(--body-size); font-weight: 600; margin-bottom: 5rpx; }.grade-fields { margin-top: 20rpx; }.grade-field { display: flex; align-items: baseline; gap: 22rpx; padding: 10rpx 0; font-size: 25rpx; }.grade-field>text:first-child { width: 190rpx; flex-shrink: 0; color: var(--ink-2); }.grade-field>text+text { flex: 1; min-width: 0; word-break: break-all; }.summary-list { background: var(--campus-surface); padding: 0 32rpx; }.summary-row { display: flex; justify-content: space-between; align-items: baseline; gap: 24rpx; padding: 26rpx 0; border-bottom: 1rpx solid var(--campus-line); font-size: 27rpx; }.summary-row>text:first-child { color: var(--ink-2); }.summary-row>text+text { color: var(--campus-accent-ink); font-size: 32rpx; font-weight: 600; word-break: break-all; text-align: right; }.summary-rule { color: var(--ink-2); padding: 24rpx 32rpx; font-size: 23rpx; line-height: 1.8; }
.academic-error { margin-left: var(--page-gutter); margin-right: var(--page-gutter); }
.academic-header, .data-toolbar, .course-row, .grade-record, .summary-list, .summary-rule { padding-left: var(--page-gutter); padding-right: var(--page-gutter); }
.week-strip { padding-left: var(--page-gutter); padding-right: var(--page-gutter); }
.academic-heading-action { flex-shrink: 0; line-height: 34rpx; }
.academic-tab { min-width: 0; line-height: 40rpx; }
.grade-field { gap: 24rpx; }
.grade-field>text:first-child { width: var(--field-label-width); }
.grade-field>text { line-height: 42rpx; }

/* Selected design overrides. */
.course-row { min-height: var(--course-height); }
.academic-tabs .academic-tab.active { color: var(--campus-accent-ink); }
.week-day.active { background: var(--primary); color: var(--campus-on-accent); }
.course-section { border-right-color: var(--campus-line); }
