/* chat-minimal —— 极简对话界面
   风格：achromatic-ledger（tasteskill v2 app sheet，seed 1326006843）
   · chrome 无彩色；底色低彩度、内容纯白；无阴影、无渐变、无玻璃
   · 唯一彩色 #1D5FBF，只点在"小北"消息的前缀标记上（占屏 <1%）
   · 唯一主行动（发送）用近黑；分隔靠色调台阶与留白，不靠线和阴影
   尺寸按 1px = 2rpx 换算（设计稿 750rpx） */

page {
  --ground: #F5F6F8;
  --surface: #FFFFFF;
  --border: #E6E6E6;
  --text: #0A0A0A;
  --muted: #6B6B6B;
  --accent: #141414;
  --hue: #1D5FBF;

  --r-card: 16rpx;
  --r-control: 12rpx;
  --pad: 40rpx;
  --gap: 24rpx;

  background: var(--ground);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--ground);
}

/* ── 顶栏：48px，无底边线，靠留白和下面分开 ─────────────────────── */
.bar {
  flex: none;
  background: var(--ground);
}
.bar__inner {
  display: flex;
  align-items: center;
  padding: 0 var(--pad);
}
.bar__title {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--text);
  line-height: 1;
}
.bar__sub {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1;
}
.bar__action {
  margin-left: auto;
  font-size: 28rpx;
  color: var(--muted);
  padding: 12rpx 0 12rpx 24rpx;
}
.tapped { opacity: .55; }

/* ── 对话流 ──────────────────────────────────────────────────── */
.thread {
  flex: 1;
  min-height: 0;
  background: var(--ground);
}
.thread__inner {
  padding: 28rpx var(--pad) 0;
}
.thread__tail { height: 40rpx; }

/* 一条消息：小北左、用户右；都不用气泡，靠对齐和标记分开 */
.msg {
  display: flex;
  align-items: flex-start;
  margin-top: 44rpx;
}
.msg:first-child { margin-top: 8rpx; }

.msg--bot { justify-content: flex-start; }
.msg--user { justify-content: flex-end; }

/* 唯一彩色：小北消息前的小圆点 */
.msg__mark {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--hue);
  margin-top: 16rpx;
  margin-right: 18rpx;
}

.msg__body { max-width: 84%; }
.msg__text {
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--text);
  word-break: break-word;
}
.msg--user .msg__body { max-width: 76%; text-align: right; }

/* ── 开场入口：三行具体动作，不做彩色 chip ───────────────────── */
.starters {
  margin-top: 10rpx;
  padding-left: 32rpx;
}
.starter {
  padding: 22rpx 0;
}
.starter__text {
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--muted);
}
.starter:active .starter__text { color: var(--text); }

/* 正在输入：三个点，无外框 */
.typing {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 44rpx;
}
.typing__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--muted);
  opacity: .45;
  animation: blink 1.1s var(--ease, ease) infinite;
}
.typing__dot:nth-child(2) { animation-delay: .16s; }
.typing__dot:nth-child(3) { animation-delay: .32s; }
@keyframes blink {
  0%, 100% { opacity: .25; }
  50% { opacity: .8; }
}

/* ── 输入区：唯一主行动用近黑 ───────────────────────────────── */
.dock {
  flex: none;
  padding: 20rpx var(--pad) 0;
  background: var(--ground);
  border-top: 1rpx solid var(--border);
}
.dock__field {
  display: flex;
  align-items: center;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-control);
  padding: 0 8rpx 0 24rpx;
  height: 88rpx;
  transition: border-color 160ms ease;
}
.dock__field--active { border-color: #C9C9C9; }
.dock__input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: 30rpx;
  color: var(--text);
  background: transparent;
}
.dock__ph { color: var(--muted); }
.dock__send {
  flex: none;
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--muted);
  background: transparent;
  transition: background-color 160ms ease, color 160ms ease;
}
.dock__send--on {
  color: #FFFFFF;
  background: var(--accent);
}
.dock__send--pressed { opacity: .82; }

.footnote {
  padding: 18rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--muted);
}

/* 尊重系统"减少动态效果" */
@media (prefers-reduced-motion: reduce) {
  .typing__dot { animation: none; opacity: .5; }
  .dock__field, .dock__send { transition: none; }
}
