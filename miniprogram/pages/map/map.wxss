.map-root { height: 100vh; overflow: hidden; background: var(--campus-tone-green); }.campus-map { position: fixed; left: 0; width: 100%; }.map-toolbar { position: fixed; left: 24rpx; right: 24rpx; z-index: 8; }.map-search { display: flex; align-items: center; height: 96rpx; background: var(--campus-surface); border-radius: var(--content-radius); box-shadow: none; padding: 0 20rpx; gap: 16rpx; }.map-campus-name { display: flex; align-items: center; max-width: 240rpx; white-space: nowrap; font-size: 25rpx; color: var(--campus-accent-ink); overflow: hidden; }.search-divider { height: 34rpx; width: 1rpx; background: var(--campus-tone-green); flex-shrink: 0; }.map-search input { flex: 1; min-width: 0; width: 0; height: 88rpx; line-height: 88rpx; font-size: 26rpx; }.map-search-button { width: 40rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.map-mode { display: inline-flex; padding: 6rpx; margin-top: 18rpx; border-radius: var(--content-radius); background: var(--campus-surface); box-shadow: none; }.map-mode-item { display: flex; align-items: center; gap: 10rpx; font-size: 23rpx; padding: 12rpx 18rpx; border-radius: var(--content-radius); color: var(--ink-2); }.map-mode-item.active { background: var(--campus-tone-green); color: var(--campus-accent-ink); font-weight: 600; }.map-mode-item image { width: 29rpx; height: 29rpx; }
.map-tools { position: fixed; right: 24rpx; z-index: 7; display: flex; flex-direction: column; gap: 16rpx; }.map-tool { width: 78rpx; height: 78rpx; display: flex; align-items: center; justify-content: center; background: var(--campus-surface); border-radius: var(--content-radius); box-shadow: none; }.map-tool image { width: 38rpx; height: 38rpx; }.map-tool.active { background: var(--campus-tone-green); }
.map-sheet { position: fixed; left: 0; right: 0; z-index: 10; background: var(--campus-canvas); border-radius: var(--content-radius); box-shadow: none; overflow: hidden; backdrop-filter: none; }.sheet-handle-area { height: 34rpx; display: flex; align-items: center; justify-content: center; }.sheet-handle { width: 64rpx; height: 7rpx; border-radius: var(--content-radius); background: var(--campus-tone-green); }.sheet-heading { height: 62rpx; padding: 0 30rpx; display: flex; align-items: center; gap: 18rpx; }.sheet-title { flex: 1; min-width: 0; font-size: 31rpx; font-weight: 600; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.sheet-count { font-size: 22rpx; color: var(--ink-2); flex-shrink: 0; }.sheet-close { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; }.map-categories { height: 76rpx; width: calc(100% - 48rpx); margin: 0 24rpx; white-space: nowrap; border-bottom: 1rpx solid var(--campus-line); }.map-category { display: inline-block; padding: 15rpx 10rpx; margin-right: 24rpx; font-size: 24rpx; color: var(--ink-2); border-bottom: 4rpx solid transparent; }.map-category.active { color: var(--campus-accent-ink); font-weight: 600; border-bottom-color: var(--campus-line); }.sheet-scroll { height: calc(100% - 172rpx); }.sheet-scroll-selected { height: calc(100% - 96rpx); }.place-result { display: flex; align-items: center; padding: 22rpx 30rpx; gap: 20rpx; border-bottom: 1rpx solid var(--campus-line); }.place-cover { width: 88rpx; height: 88rpx; border-radius: var(--content-radius); flex-shrink: 0; }.place-symbol { width: 82rpx; height: 82rpx; border-radius: var(--content-radius); background: var(--campus-tone-green); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }.place-symbol image { width: 36rpx; height: 36rpx; }.place-main { flex: 1; min-width: 0; }.place-title { font-size: var(--body-size); font-weight: 500; }.place-meta { font-size: 22rpx; color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 5rpx; }
.selected-summary { display: flex; padding: 22rpx 30rpx 16rpx; gap: 20rpx; }.selected-summary>image { width: 128rpx; height: 128rpx; flex-shrink: 0; border-radius: var(--content-radius); }.selected-summary>view { flex: 1; min-width: 0; }.selected-category { font-size: 22rpx; color: var(--campus-accent-ink); }.selected-description { color: var(--ink-2); font-size: 24rpx; margin-top: 7rpx; line-height: 1.6; }.selected-detail-link { display: flex; align-items: center; color: var(--campus-accent-ink); font-size: 22rpx; margin-top: 10rpx; }.route-start { display: flex; align-items: center; padding: 20rpx 30rpx; border-top: 1rpx solid var(--campus-line); gap: 26rpx; font-size: 25rpx; }.route-start>text { color: var(--ink-2); }.route-start picker { flex: 1; min-width: 0; }.route-start picker view { display: flex; align-items: center; justify-content: space-between; }.route-options { margin: 0 30rpx 20rpx; }.route-actions { display: flex; gap: 16rpx; padding: 0 30rpx 24rpx; }.route-actions button { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; gap: 10rpx; height: 80rpx; font-size: 25rpx; border-radius: var(--content-radius); }.native-route { background: var(--campus-tone-green); color: var(--campus-accent-ink); }.campus-route { background: var(--primary); color: var(--campus-on-accent); }.route-actions button[disabled] { opacity: .5; }.route-error { margin: 0 30rpx 20rpx; padding: 16rpx; background: var(--campus-tone-orange); color: var(--signal-ink); font-size: 23rpx; border-radius: var(--content-radius); word-break: break-all; }.route-summary { display: flex; align-items: baseline; flex-wrap: wrap; gap: 18rpx; padding: 6rpx 30rpx 22rpx; color: var(--campus-accent-ink); font-size: 32rpx; font-weight: 600; }.route-summary text+text { font-size: 24rpx; }.route-clear { font-size: 22rpx; color: var(--ink-2); font-weight: 400; margin-left: auto; }.route-step { display: flex; gap: 18rpx; margin: 0 30rpx; padding: 16rpx 0; border-top: 1rpx solid var(--campus-line); font-size: 24rpx; }.route-step text { color: var(--campus-accent-ink); }.map-source, .map-warning { font-size: 19rpx; color: var(--signal-ink); text-align: center; padding: 18rpx; }.map-warning { color: var(--signal-ink); }
.map-campus-name text { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.map-campus-name image { flex-shrink: 0; }
.map-toolbar { left: var(--page-gutter); right: var(--page-gutter); }
.map-tools { right: var(--page-gutter); }
.sheet-heading, .place-result, .selected-summary, .route-start, .route-actions, .route-summary { padding-left: var(--page-gutter); padding-right: var(--page-gutter); }
.place-symbol { width: 88rpx; height: 88rpx; }
.place-symbol image { display: block; }
.place-title { line-height: 38rpx; }
.place-meta { line-height: 32rpx; }
.route-options, .route-error, .route-step { margin-left: var(--page-gutter); margin-right: var(--page-gutter); }

/* Selected design overrides. */
.map-root { background: var(--campus-canvas); }
.map-toolbar { width: auto; }
.map-search { width: var(--search-width); margin: 0 auto; height: var(--search-height); border-radius: var(--glass-radius); background: rgba(var(--glass-rgb), var(--glass-fill)); border: 1rpx solid rgba(255,255,255,var(--glass-highlight)); backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)); -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)); box-shadow: 0 8rpx 24rpx rgba(0,0,0,var(--glass-shadow)); }
.map-search input { height: calc(var(--search-height) - 4rpx); line-height: calc(var(--search-height) - 4rpx); color: var(--ink); }
.map-campus-name { max-width: 224rpx; }
.map-tool { width: var(--map-control-size); height: var(--map-control-size); border-radius: calc(var(--glass-radius) / 2); background: var(--campus-glass); border: 1rpx solid var(--campus-line); }
.map-tool image { width: var(--icon-size); height: var(--icon-size); }
.map-mode-item.active { background: var(--campus-tone-green); color: var(--ink); }
.map-sheet { background: var(--campus-surface); border-radius: var(--content-radius) var(--content-radius) 0 0; border-top: 1rpx solid var(--campus-line); backdrop-filter: none; }
.sheet-handle { background: var(--campus-line); }
.campus-route { background: var(--primary); color: var(--campus-on-accent); }
.map-warning, .route-error { color: var(--signal-ink); }

/* Keep discovery controls separate from the scrollable place list. */
.map-sheet { display: flex; flex-direction: column; }
.sheet-handle-area, .sheet-heading { flex-shrink: 0; }
.sheet-heading-categories { min-height: 44px; }
.sheet-scroll, .map-category-scroll { flex: 1; min-height: 0; height: 0; width: 100%; }
.map-filter-bar { display: flex; gap: 20rpx; padding: 12rpx var(--page-gutter) 20rpx; flex-shrink: 0; }
.map-root button.map-filter-button {
  flex: 1; min-width: 0; min-height: 44px; margin: 0; padding: 0 22rpx;
  display: flex; align-items: center; justify-content: flex-start; gap: 14rpx;
  border-radius: calc(var(--content-radius) + 8rpx); font-size: 14px; line-height: 1.4;
  color: var(--ink-2); text-align: left;
}
.map-filter-button > image { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.map-filter-button > text { flex: 1; min-width: 0; padding: 18rpx 0; overflow-wrap: break-word; }
.map-filter-button > image.map-filter-chevron { width: 28rpx; height: 28rpx; }
.map-filter-dot { width: 10rpx; height: 10rpx; margin: 0 9rpx; border-radius: 50%; background: var(--campus-accent); flex-shrink: 0; }
.map-root button.map-category-done {
  display: flex; align-items: center; justify-content: center; gap: 8rpx; flex-shrink: 0;
  min-width: 76px; min-height: 44px; margin: 0 -12rpx 0 0; padding: 0 12rpx;
  font-size: 14px; line-height: 1.4; border-radius: calc(var(--content-radius) + 8rpx); color: var(--campus-accent-ink);
}
.map-category-done image { width: 28rpx; height: 28rpx; transform: rotate(180deg); }
.map-category-intro { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; padding: 20rpx var(--page-gutter) 24rpx; color: var(--ink-2); font-size: 13px; }
.map-category-intro > text { font-size: 12px; flex-shrink: 0; }
.map-category-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20rpx; padding: 0 var(--page-gutter) 28rpx; }
.map-root button.map-category-tile {
  display: flex; flex-direction: column; align-items: stretch; justify-content: space-between;
  min-width: 0; width: 100%; min-height: 84px; margin: 0; padding: 20rpx 18rpx;
  border-radius: calc(var(--content-radius) + 8rpx); text-align: left; color: var(--ink); line-height: 1.4;
}
.map-category-name { display: block; font-size: 14px; line-height: 1.5; font-weight: 500; overflow-wrap: break-word; word-break: break-all; }
.map-category-meta { display: flex; align-items: center; justify-content: space-between; gap: 4rpx; margin-top: 14rpx; font-size: 11px; line-height: 1.5; color: var(--ink-2); font-variant-numeric: tabular-nums; }
.map-category-meta image { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.map-root button.map-filter-button.is-current, .map-root button.map-category-tile.is-current { background-color: var(--campus-tone-green); color: var(--campus-accent-ink); font-weight: 600; box-shadow: var(--control-glass-shadow), inset 0 0 0 1px var(--campus-accent); }
.map-connection-error { padding: 32rpx var(--page-gutter); }
.map-connection-error .state-title { line-height: 1.6; }
.map-root button.map-retry-button { display: flex; align-items: center; justify-content: center; min-height: 44px; max-width: 280rpx; margin: 20rpx auto 0; padding: 12rpx 28rpx; color: var(--campus-accent-ink); font-size: 28rpx; }

/* Destination first, with one persistent departure action. */
.route-start { align-items: flex-start; gap: 20rpx; padding-top: 20rpx; padding-bottom: 20rpx; }
.route-origin-dot { width: 14rpx; height: 14rpx; margin: 12rpx 6rpx 0; border-radius: 50%; background: var(--campus-accent); box-shadow: 0 0 0 7rpx var(--campus-tone-green); flex-shrink: 0; }
.route-origin-picker { display: block; margin: 0 var(--page-gutter); border-radius: calc(var(--content-radius) + 8rpx); background: var(--campus-tone-green); }
.route-origin-picker .route-start { min-height: 44px; padding: 20rpx; align-items: center; }
.route-origin-picker .route-start > image { flex-shrink: 0; }
.route-origin-copy { display: flex; flex: 1; flex-direction: column; gap: 10rpx; min-width: 0; line-height: 1.5; }
.route-origin-copy > text:first-child { color: var(--ink); font-size: 28rpx; font-weight: 500; }
.route-origin-hint { font-size: 22rpx; line-height: 1.6; color: var(--ink-2); overflow-wrap: anywhere; }
.route-actions { flex-shrink: 0; padding-top: 16rpx; padding-bottom: 20rpx; background: var(--campus-surface); box-shadow: 0 -5rpx 20rpx rgba(27,63,103,.04); }
.map-root .route-actions .campus-route { min-height: 48px; height: auto; margin: 0; padding: 20rpx; line-height: 1.4; font-size: 30rpx; font-weight: 600; color: var(--campus-on-accent); background: var(--primary); border-radius: calc(var(--content-radius) + 8rpx); }
.route-summary { gap: 16rpx; font-variant-numeric: tabular-nums; }
.route-summary .route-overview-note { width: 100%; font-size: 22rpx; font-weight: 400; color: var(--ink-2); }
.map-offline-state { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 16rpx; padding: 12rpx var(--page-gutter); color: var(--ink-2); font-size: 22rpx; }
.map-root .map-offline-state button { min-height: 36px; margin: 0; padding: 8rpx 20rpx; line-height: 1.5; color: var(--campus-accent-ink); font-size: 24rpx; }
