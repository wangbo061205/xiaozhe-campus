.mine-section .section-title {
  margin-bottom: 24rpx;
  font-size: var(--body-size);
  line-height: 42rpx;
}

.mine-section .section-head .section-title {
  margin-bottom: 0;
}

.ph {
  color: var(--ink-3);
}

.mine-section .form-input,
.todo-add-input,
.fb-textarea {
  width: 100%;
  background: var(--campus-tone-green);
  border: 1rpx solid var(--campus-line);
  box-shadow: none;
}

.mine-section .btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 84rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 42rpx;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-top: 36rpx;
  padding-bottom: 36rpx;
}

.user-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 96rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--campus-tone-green);
}

.user-avatar image {
  display: block;
  width: 48rpx;
  height: 48rpx;
  transform: translateY(-1rpx);
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  margin-bottom: 6rpx;
  font-size: var(--body-size);
  line-height: 46rpx;
  font-weight: 600;
  overflow-wrap: break-word;
}

.user-status {
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--ink-3);
}

.service-section {
  padding-bottom: 20rpx;
}

.service-grid {
  display: flex;
  flex-wrap: wrap;
  row-gap: 12rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 0 0 33.333333%;
  width: 33.333333%;
  min-width: 0;
  height: 148rpx;
  gap: 12rpx;
  padding: 12rpx 0;
}

.service-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--content-radius);
}

.service-symbol image {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

/* Balance the visible strokes while keeping the icon boxes fixed. */
.service-symbol--graduation-cap image {
  width: 44rpx;
  height: 44rpx;
  transform: translate(-1rpx, -1rpx);
}

.service-symbol--heart image {
  transform: translateY(1rpx);
}

.service-symbol--school image,
.service-symbol--ticket image {
  transform: translateY(-1rpx);
}

.tone-green { background: var(--campus-tone-green); }
.tone-blue { background: var(--campus-tone-blue); }
.tone-rose { background: var(--campus-tone-rose); }

.service-name {
  display: block;
  width: 100%;
  height: 36rpx;
  font-size: 25rpx;
  line-height: 36rpx;
  text-align: center;
  white-space: nowrap;
  color: var(--ink);
}

.run-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--campus-line);
}

.run-item:last-child {
  padding-bottom: 4rpx;
  border-bottom: 0;
}

.run-item-main {
  flex: 1;
  min-width: 0;
}

.run-item-title {
  font-size: var(--body-size);
  line-height: 42rpx;
  font-weight: 500;
  overflow-wrap: break-word;
}

.run-item-meta {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 34rpx;
  color: var(--ink-3);
}

.run-item-arrow {
  display: block;
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  opacity: .65;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.option-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  min-height: 72rpx;
  padding: 16rpx;
  background: var(--campus-tone-green);
  border: 1rpx solid var(--campus-line);
  border-radius: var(--content-radius);
}

.option-item.on {
  color: var(--campus-accent-ink);
  background: var(--campus-tone-green);
  border-color: var(--campus-line);
}

.option-label {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  line-height: 36rpx;
  text-align: left;
}

.option-check,
.option-radio {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 30rpx;
  width: 30rpx;
  height: 30rpx;
  background: var(--campus-surface);
  border: 2rpx solid var(--campus-line);
}

.option-check {
  border-radius: var(--content-radius);
}

.option-check image {
  display: block;
  width: 24rpx;
  height: 24rpx;
}

.on .option-check {
  background: var(--primary);
  border-color: var(--primary);
}

.option-radio {
  border-radius: 50%;
}

.on .option-radio {
  border-color: var(--primary);
}

.option-radio-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--primary);
}

.feed-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--campus-line);
}

.feed-item:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.feed-type {
  flex: 0 0 100rpx;
  width: 100rpx;
  padding: 4rpx 6rpx;
  border-radius: var(--content-radius);
  background: var(--campus-tone-blue);
  color: var(--ink);
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.feed-title {
  flex: 1;
  min-width: 0;
  padding-top: 1rpx;
  font-size: 26rpx;
  line-height: 38rpx;
  color: var(--ink-2);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.todo-count {
  flex-shrink: 0;
  font-size: 23rpx;
  line-height: 34rpx;
  color: var(--ink-3);
}

.todo-add-row {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.todo-add-field {
  flex: 1;
  min-width: 0;
}

.todo-add-input {
  font-size: 25rpx;
}

.todo-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 108rpx;
  width: 108rpx;
  height: 84rpx;
  border-radius: var(--content-radius);
  background: var(--primary);
  color: var(--campus-on-accent);
  font-size: 26rpx;
  line-height: 38rpx;
}

.todo-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--campus-line);
}

.todo-item:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.todo-main {
  flex: 1;
  min-width: 0;
}

.todo-title {
  font-size: var(--body-size);
  line-height: 42rpx;
  overflow-wrap: break-word;
}

.todo-note {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 34rpx;
  color: var(--ink-3);
  overflow-wrap: break-word;
}

.todo-done .todo-title {
  text-decoration: line-through;
  color: var(--ink-3);
}

.todo-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 8rpx;
}

.todo-act {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 76rpx;
  min-height: 64rpx;
  padding: 12rpx 8rpx;
  font-size: 23rpx;
  line-height: 34rpx;
  color: var(--ink-3);
}

.done-act {
  color: var(--campus-accent-ink);
}

.mine-section .empty {
  padding: 48rpx 0;
}

.empty-symbol {
  display: block;
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto 16rpx;
  opacity: .6;
}

.fb-textarea {
  display: block;
  height: 200rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  line-height: 40rpx;
}

.about-tip {
  padding: 24rpx var(--page-gutter) 20rpx;
  font-size: 21rpx;
  line-height: 34rpx;
  text-align: center;
  color: var(--ink-3);
}

.about-tip text {
  display: block;
}

/* Selected design overrides. */
.user-avatar { flex-basis: var(--avatar-size); width: var(--avatar-size); height: var(--avatar-size); }
.user-avatar image { width: calc(var(--avatar-size) / 2); height: calc(var(--avatar-size) / 2); }
.service-symbol { width: var(--shortcut-size); height: var(--shortcut-size); }
.service-symbol image { width: var(--icon-size); height: var(--icon-size); }
.service-symbol--graduation-cap image { width: calc(var(--icon-size) + 4rpx); height: calc(var(--icon-size) + 4rpx); }
.service-item { height: calc(var(--shortcut-size) + 74rpx); }
.service-name { color: var(--ink); }
.todo-add-btn { color: var(--campus-on-accent); }
.feed-type { color: var(--ink); }
