.nav-fixed { position: fixed; left: 0; right: 0; top: 0; z-index: 200; padding-left: var(--page-gutter); background: var(--campus-canvas); pointer-events: none; }
.nav-pill { pointer-events: auto; display: flex; align-items: center; gap: 12rpx; padding: 0; color: var(--ink); background: transparent; box-shadow: none; border: 0; min-width: 0; }
.nav-dot { display: block; width: var(--icon-size); height: var(--icon-size); flex-shrink: 0; }
.nav-title { flex: 1; min-width: 0; font-size: 30rpx; line-height: 42rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nav-tail { font-size: 22rpx; color: var(--ink-2); flex-shrink: 0; }
.nav-back { display: flex; align-items: center; justify-content: flex-start; width: 48rpx; height: 64rpx; flex-shrink: 0; }
.nav-back__icon { display: block; width: 36rpx; height: 36rpx; transform: translateX(-3rpx); }
.nav-press { transition: opacity var(--motion-duration); }
.nav-pressed { opacity: .6; }
.nav-holder { flex-shrink: 0; }
.nav-pill button.nav-action { display: flex; align-items: center; justify-content: center; flex-shrink: 0; min-width: 68px; min-height: 44px; margin: 0; padding: 0 14px; border: 0; border-radius: 22px; background-color: rgba(var(--glass-rgb),var(--glass-fill)); background-image: linear-gradient(rgba(255,255,255,.1),rgba(255,255,255,.1)); color: var(--campus-accent-ink); font-size: 24rpx; line-height: 1.4; font-weight: 500; box-shadow: 0 2px 3px rgba(24,50,83,.02), 0 6px 16px rgba(24,50,83,.04), inset 0 0 0 1px rgba(255,255,255,.9), inset -1px -1px 1px rgba(54,92,143,.06); backdrop-filter: blur(14px) saturate(150%); -webkit-backdrop-filter: blur(14px) saturate(150%); transition: opacity 140ms ease; }
.nav-action::after { border: 0; }
.nav-pill.gq-low .nav-action { background: var(--campus-surface); backdrop-filter: none; -webkit-backdrop-filter: none; }
.nav-pill.high-contrast .nav-action { background: var(--campus-surface); box-shadow: inset 0 0 0 1px var(--ink-2); backdrop-filter: none; -webkit-backdrop-filter: none; }
.nav-pill.motion-reduced .nav-action { transition: none; }
@media (prefers-reduced-motion: reduce) { .nav-pill button.nav-action { transition: none; } }
@media (prefers-reduced-transparency: reduce) { .nav-pill button.nav-action { background: var(--campus-surface); backdrop-filter: none; -webkit-backdrop-filter: none; } }
@media (prefers-contrast: more) { .nav-pill button.nav-action { background: var(--campus-surface); box-shadow: inset 0 0 0 1px var(--ink-2); backdrop-filter: none; -webkit-backdrop-filter: none; } }
