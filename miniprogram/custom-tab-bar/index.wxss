@import "../styles/navigation-tokens.wxss";
.tabbar-dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 300; padding: 0 0 calc(20rpx + env(safe-area-inset-bottom)); pointer-events: none; }
.tabbar { box-sizing: border-box; pointer-events: auto; position: relative; display: flex; align-items: stretch; width: var(--nav-width); height: var(--nav-height); margin: 0 auto; padding: 8rpx; border-radius: var(--glass-radius); background: rgba(var(--glass-rgb), var(--glass-fill)); border: 1rpx solid rgba(255,255,255,var(--glass-highlight)); box-shadow: 0 8rpx 32rpx rgba(0,0,0,var(--glass-shadow)), inset 0 1rpx 0 rgba(255,255,255,.2); backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)); -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation)); }
.tabbar.gq-low { background: var(--campus-glass); backdrop-filter: none; -webkit-backdrop-filter: none; }
.tabbar__thumb { position: absolute; left: 8rpx; top: 8rpx; bottom: 8rpx; width: calc((100% - 16rpx) / 5); border-radius: calc(var(--glass-radius) - 8rpx); background: var(--campus-tone-green); border: 1rpx solid var(--campus-line); transition: transform var(--motion-duration) var(--ease); pointer-events: none; box-sizing: border-box; }
.tabbar__item { position: relative; z-index: 1; display: flex; flex: 1 1 0; min-width: 0; flex-direction: column; align-items: center; justify-content: center; gap: 7rpx; padding: 4rpx 0; color: var(--ink-2); box-sizing: border-box; }
.tabbar__item--on { color: var(--campus-accent-ink); }
.tabbar__item--on .tabbar__label { font-weight: 600; }
.tabbar__item--press { opacity: .7; }
.tabbar__icon { display: block; width: var(--icon-size); height: var(--icon-size); flex-shrink: 0; }
.tabbar__label { display: block; width: 100%; height: 28rpx; line-height: 28rpx; font-size: 21rpx; text-align: center; white-space: nowrap; }
.tabbar.gq-low .tabbar__thumb { transition: none; }
.tabbar { border: 0; background-image: linear-gradient(rgba(255,255,255,var(--glass-coat)),rgba(255,255,255,var(--glass-coat))); box-shadow: 0 2rpx 4rpx rgba(0,0,0,.025), 0 12rpx 32rpx rgba(0,0,0,.055), 0 36rpx 72rpx -24rpx rgba(0,0,0,var(--glass-shadow)), inset 0 0 0 1px rgba(255,255,255,var(--glass-highlight)); }
.tabbar__thumb { border: 0; box-shadow: 0 1rpx 3rpx rgba(24,50,83,.035), 0 4rpx 12rpx rgba(24,50,83,.04); }
.tabbar.motion-reduced .tabbar__thumb { transition: none; }
.tabbar { box-shadow: 0 2rpx 4rpx rgba(0,0,0,.025), 0 12rpx 32rpx rgba(0,0,0,.055), 0 36rpx 72rpx -24rpx rgba(0,0,0,var(--glass-shadow)), inset 0 0 0 1px rgba(255,255,255,var(--glass-highlight)), inset 2px 1px 1px rgba(255,255,255,calc(var(--glass-coat) * 1.4)), inset -2px -2px 1px rgba(24,50,83,calc(var(--glass-coat) * .6)); }
.tabbar.gq-low { background-image: none; box-shadow: 0 4rpx 12rpx rgba(0,0,0,.08), inset 0 0 0 1px rgba(255,255,255,.4); }
.tabbar.high-contrast { background: var(--campus-surface); border: 1px solid var(--ink); box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; }
.tabbar.high-contrast .tabbar__thumb { border: 1px solid var(--ink); box-shadow: none; }
@media (prefers-reduced-transparency: reduce) { .tabbar { background: var(--campus-surface); backdrop-filter: none; -webkit-backdrop-filter: none; box-shadow: 0 4rpx 12rpx rgba(0,0,0,.08); } }
@media (prefers-contrast: more) { .tabbar { background: var(--campus-surface); border: 1px solid var(--ink); box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; } .tabbar__thumb { border: 1px solid var(--ink); box-shadow: none; } }
