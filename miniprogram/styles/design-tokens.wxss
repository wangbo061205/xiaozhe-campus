/* Exported from Campus Design Lab. Units: 1 CSS px = 2rpx at 375px design width.
   Refraction, aberration and elastic deformation require the Web library.
   WXSS below provides a material approximation; validate on WeChat devices. */
page {
  --campus-accent: #2164B5;
  --campus-canvas: #F3F7FC;
  --campus-surface: #FFFFFF;
  --campus-text: #24354B;
  --campus-secondary: #526781;
  --campus-line: #DDE7F3;
  --campus-signal: #9A462F;
  --campus-glass: #FFFFFF;
  --campus-tone-green: #E7F0FB;
  --campus-tone-blue: #E7F0FB;
  --campus-tone-rose: #E7F0FB;
  --campus-tone-orange: #E7F0FB;
  --campus-on-accent: #FFFFFF;
  --campus-accent-ink: #2164B5;
  --page-gutter: 24rpx;
  --section-gap: 24rpx;
  --content-radius: 16rpx;
  --body-size: 28rpx;
  --icon-size: 38rpx;
  --hero-height: 308rpx;
  --search-width: 91%;
  --search-height: 88rpx;
  --shortcut-size: 86rpx;
  --course-height: 200rpx;
  --activity-image-size: 100rpx;
  --avatar-size: 80rpx;
  --lost-image-size: 88rpx;
  --nav-width: 90%;
  --nav-height: 128rpx;
  --map-control-size: 88rpx;
  --map-sheet-height: 240rpx;
  --composer-height: 96rpx;
  --glass-radius: 80rpx;
  --glass-fill: 0.3;
  --glass-blur: 26rpx;
  --glass-saturation: 1.4;
  --glass-highlight: 0.6;
  --glass-shadow: 0.12;
  --motion-duration: 180ms;
  --surface-inset: 28rpx;
  --surface-radius: calc(var(--content-radius) + var(--surface-inset));
  --surface-shadow: 0 1rpx 3rpx rgba(24,50,83,.025), 0 8rpx 24rpx rgba(24,50,83,.035), 0 24rpx 56rpx -20rpx rgba(24,50,83,.075);
  --glass-coat: 0.1;
  --reveal-duration: 280ms;
}
.campus-theme-light {
  --campus-accent: #2164B5;
  --campus-canvas: #F3F7FC;
  --campus-surface: #FFFFFF;
  --campus-text: #24354B;
  --campus-secondary: #526781;
  --campus-line: #DDE7F3;
  --campus-signal: #9A462F;
  --campus-glass: #FFFFFF;
  --campus-tone-green: #E7F0FB;
  --campus-tone-blue: #E7F0FB;
  --campus-tone-rose: #E7F0FB;
  --campus-tone-orange: #E7F0FB;
  --campus-on-accent: #FFFFFF;
  --campus-accent-ink: #2164B5;
}
.campus-theme-dark {
  --campus-accent: #A8CAFF;
  --campus-canvas: #172333;
  --campus-surface: #223248;
  --campus-text: #DCE7F5;
  --campus-secondary: #B7C7DC;
  --campus-line: #3B506B;
  --campus-signal: #E7AD91;
  --campus-glass: #263B55;
  --campus-tone-green: #2D4562;
  --campus-tone-blue: #2D4562;
  --campus-tone-rose: #2D4562;
  --campus-tone-orange: #2D4562;
  --campus-on-accent: #15263D;
  --campus-accent-ink: #A8CAFF;
}
.campus-content {
  padding: var(--section-gap) var(--page-gutter);
  color: var(--campus-text);
  background: var(--campus-surface);
  font-size: var(--body-size);
}
.campus-glass {
  background: rgba(255, 255, 255, var(--glass-fill));
  border-radius: var(--glass-radius);
  border: 0;
  backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
  background-image: linear-gradient(rgba(255,255,255,var(--glass-coat)),rgba(255,255,255,var(--glass-coat)));
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,.025), 0 12rpx 32rpx rgba(0,0,0,.055), 0 36rpx 72rpx -24rpx rgba(0,0,0,var(--glass-shadow)), inset 0 0 0 1px rgba(255,255,255,var(--glass-highlight));
}
.campus-theme-dark .campus-glass {
  background: rgba(38, 59, 85, var(--glass-fill));
}
.campus-theme-light .campus-glass {
  background: rgba(255, 255, 255, var(--glass-fill));
}

@media (prefers-reduced-motion: reduce) {
  page { --motion-duration: 0ms; }
}

@media (prefers-reduced-transparency: reduce) {
  page { --glass-fill: 1; --glass-coat: 0; --glass-blur: 0rpx; --glass-saturation: 1; }
}

page {
  --mist: var(--campus-canvas);
  --sand: var(--campus-canvas);
  --grain: var(--campus-tone-green);
  --primary: var(--campus-accent);
  --primary-2: var(--campus-accent-ink);
  --ink: var(--campus-text);
  --ink-2: var(--campus-secondary);
  --ink-3: var(--campus-secondary);
  --signal-ink: #9A462F;
  --danger: #B42318;
  --ok: var(--campus-accent-ink);
  --glass-rgb: 255, 255, 255;
  --tab-space: calc(var(--nav-height) + 40rpx + env(safe-area-inset-bottom));
  --field-label-width: 176rpx;
  --glass-radius-1: var(--content-radius);
  --glass-radius-2: var(--content-radius);
  --glass-radius-3: var(--glass-radius);
  --ease: cubic-bezier(.22, 1, .36, 1);
  --dur-press: var(--motion-duration);
  --dur-switch: var(--motion-duration);
  --dur-sheet: var(--motion-duration);
  --press-scale: 0.98;
}
